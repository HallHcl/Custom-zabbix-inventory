# PostgreSQL Configuration (Docker Internal)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dc_vision

# Redis Configuration (Docker Internal)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Zabbix API Configuration
ZABBIX_URL=http://your-zabbix-server/api_jsonrpc.php
ZABBIX_API_TOKEN=your_zabbix_api_token_here
ZABBIX_SYNC_INTERVAL_SECONDS=30

# Application Configuration
APP_ENV=production
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Exposed Host Port (Custom port to avoid conflicts with other containers)
FRONTEND_PORT=8090
