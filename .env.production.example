# PostgreSQL Configuration (Docker Internal)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dc_vision

# Redis Configuration (Docker Internal)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Zabbix API Configuration
ZABBIX_URL=http://192.168.1.85:8080/api_jsonrpc.php
ZABBIX_WEB_URL=http://192.168.1.85:8080
ZABBIX_API_TOKEN=your_zabbix_api_token_here
ZABBIX_SYNC_INTERVAL_SECONDS=30
ZABBIX_STALE_THRESHOLD_SECONDS=120
ZABBIX_DISCONNECTED_THRESHOLD_SECONDS=600
SIMULATE_ZABBIX_TELEMETRY=false
AUTO_SEED_DEMO_DATA=false

# Application Configuration
APP_ENV=production
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Exposed Host Port (Custom port to avoid conflicts with other containers)
FRONTEND_PORT=8090
