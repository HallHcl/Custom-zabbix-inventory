# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_MULTIPLE_DATABASES=zabbix_db,dcim_db
POSTGRES_DB=dcim_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Zabbix Integration Switch Mode ("external" or "embedded")
ZABBIX_MODE=external
ZABBIX_URL=http://192.168.1.85:8080/api_jsonrpc.php
ZABBIX_API_URL=http://192.168.1.85:8080/api_jsonrpc.php
ZABBIX_WEB_URL=http://192.168.1.85:8080
ZABBIX_API_TOKEN=your_zabbix_api_token_here
ZABBIX_USER=Admin
ZABBIX_PASSWORD=your_zabbix_password_here
ZABBIX_SYNC_INTERVAL_SECONDS=30
ZABBIX_STALE_THRESHOLD_SECONDS=120
ZABBIX_DISCONNECTED_THRESHOLD_SECONDS=600
SIMULATE_ZABBIX_TELEMETRY=false
AUTO_SEED_DEMO_DATA=false

# AI Provider API Key (for Knowledge Vectors & Copilot)
AI_PROVIDER_API_KEY=

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
